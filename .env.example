# Configuración de AWS DynamoDB
DYNAMODB_TABLE_NAME=url-shortener-links
AWS_REGION=us-east-1

# URL pública del backend en EC2 (Reemplaza con tu IP pública o dominio de EC2)
BASE_URL=http://<TU_IP_PUBLICA_EC2>:8000

# Orígenes permitidos para CORS (separados por coma o * para desarrollo)
ALLOWED_ORIGINS=*
